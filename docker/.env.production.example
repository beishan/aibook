# 将此文件复制为 Jenkins 的 Secret file 凭据，建议凭据 ID：aibook-production-env。
# 不要把包含真实密码的 docker/.env.production 提交到 Git。

DB_PASSWORD=请替换为强数据库密码
REDIS_PASSWORD=请替换为强Redis密码
MINIO_USER=aibook
MINIO_PASSWORD=请替换为强MinIO密码
JWT_SECRET=请替换为至少32字节的随机JWT密钥

# 必须是飞牛 NAS 宿主机上的绝对路径，不是 Jenkins 容器内路径。
BOOKS_PATH=/vol1/docker/aibook/books

# 可按 NAS 上的端口占用情况修改。
FRONTEND_PORT=8091
BACKEND_PORT=8092
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

JAVA_OPTS=-Xms256m -Xmx512m
APP_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
